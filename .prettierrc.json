{
    "semi": true,
    "singleQuote": true,
    "printWidth": 110,
    "tabWidth": 4,
    "trailingComma": "all",
    "plugins": ["prettier-plugin-tailwindcss"],
    "tailwindStylesheet": "./resources/css/app.css",
    "overrides": [
        {
            "files": "*.vue",
            "options": { "parser": "vue" }
        }
    ]
}
