APP_NAME=ALSAR
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# Domaine officiel : https://www.alsar.sn — en production, APP_URL doit valoir EXACTEMENT cela.
# (le www est la forme canonique : public/.htaccess redirige alsar.sn vers www.alsar.sn)
# Ce n'est pas qu'une question de liens : cette valeur est encodée dans les QR codes des cartes
# de membre et dans les emails de confirmation. Une carte déjà distribuée avec un mauvais QR ne
# se rattrape pas. Après toute modification en production : `php artisan optimize:clear`,
# sinon la configuration en cache garde l'ancienne valeur.
# En local (Laragon), on garde le vhost de développement :
APP_URL=http://alsar.test

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=alsar
DB_USERNAME=root
DB_PASSWORD=

ADMIN_NAME="Super Admin ALSAR"
ADMIN_EMAIL=admin@alsar.sn
ADMIN_PASSWORD=changeme-avant-prod

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# En production (https://www.alsar.sn), décommenter : le cookie de session n'est alors transmis
# qu'en HTTPS. Laissé vide en local, où le site tourne en http.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Expéditeur des emails transactionnels (confirmation d'adhésion, carte de membre).
# Doit être une adresse du domaine officiel : un envoi depuis un autre domaine est traité
# comme une usurpation par les filtres anti-spam et n'arrive pas.
MAIL_FROM_ADDRESS="contact@alsar.sn"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Phase 2+ (adhésion & paiement) — non utilisées en Phase 0, cf. CLAUDE.md section 13 ---
# PAYTECH_API_KEY=
# PAYTECH_API_SECRET=
# WAVE_API_KEY=
# STRIPE_KEY=
# STRIPE_SECRET=
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# SENTRY_DSN=
