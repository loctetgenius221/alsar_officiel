{
    "include": ["vite.config.ts", "vitest.config.ts"],
    "compilerOptions": {
        "composite": true,
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "moduleDetection": "force",
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "strict": true,
        "types": ["node"]
    }
}
